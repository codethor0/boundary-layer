# BoundaryLayer production environment
# Copy to .env.production and replace every CHANGE_ME value before deploy.

BOUNDARY_LAYER_ENV=production
BOUNDARY_LAYER_PROFILE=production-like

# Production SaaS (not shipped — example values only; use staging env for pre-prod)
# BOUNDARY_LAYER_PROFILE=production-saas
# BOUNDARY_LAYER_ENV=staging
# BOUNDARY_LAYER_AUTH_ENABLED=true
# BOUNDARY_LAYER_AUTH_PROVIDER=oidc
# OIDC_ISSUER_URL=https://issuer.example.com
# OIDC_AUDIENCE=boundary-layer-api
# OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# OIDC_ALGORITHMS=RS256
# OIDC_TENANT_CLAIM=https://boundarylayer.dev/tenant_id
# OIDC_ROLES_CLAIM=https://boundarylayer.dev/roles
# OIDC_SUBJECT_CLAIM=sub
# OIDC_EMAIL_CLAIM=email
# OIDC_REQUIRED_ROLES=lab_runner
# OIDC_CLOCK_SKEW_SECONDS=60
# DATABASE_URL=postgresql://boundary_layer:CHANGE_ME@db.example:5432/boundary_layer?sslmode=require
# DB_SSL_MODE=require
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=20
# DB_CONNECT_TIMEOUT_SECONDS=5
# REDIS_URL=rediss://:CHANGE_ME@redis.example:6379/0
# REDIS_CONNECT_TIMEOUT_SECONDS=3
# REDIS_KEY_PREFIX=boundary_layer:tenant
# BOUNDARY_LAYER_SECRET_KEY=CHANGE_ME-production-saas-secret-key-min-32-chars
# BOUNDARY_LAYER_ALLOWED_ORIGINS=https://app.example.com
# BOUNDARY_LAYER_PUBLIC_BASE_URL=https://app.example.com
# BOUNDARY_LAYER_SECURE_COOKIES=true
# BOUNDARY_LAYER_TRUST_PROXY_HEADERS=true
# BOUNDARY_LAYER_AUDIT_LOG_ENABLED=true
# BOUNDARY_LAYER_FILE_STORAGE_BACKEND=s3
# OBJECT_STORAGE_BUCKET=boundary-layer-artifacts
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_PREFIX=tenants/
# OBJECT_STORAGE_PRESIGNED_URL_TTL_SECONDS=900
# SECRET_MANAGER_PROVIDER=aws
# SECRET_MANAGER_PROJECT_OR_PATH=boundary-layer/production
# SECRET_ROTATION_REQUIRED=true

# API authentication (minimum 24 characters each)
BOUNDARY_LAYER_API_KEY=CHANGE_ME-production-api-key-min-24-chars
BOUNDARY_LAYER_METRICS_TOKEN=CHANGE_ME-production-metrics-token-min-24

# Alert webhook authentication
BOUNDARY_LAYER_ALERT_WEBHOOK_TOKEN=CHANGE_ME-production-webhook-token-min-24

# Data store secrets
POSTGRES_PASSWORD=CHANGE_ME-strong-postgres-password
SESSION_HMAC_SECRET=CHANGE_ME-strong-session-hmac-secret
REDIS_PASSWORD=CHANGE_ME-strong-redis-password

# External alert integrations (optional but recommended)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME
SLACK_ALERT_CHANNEL=#boundary-layer-alerts
PAGERDUTY_ROUTING_KEY=replace-with-pagerduty-routing-key

# Production TLS host
BOUNDARY_LAYER_TRUSTED_HOSTS=boundary-layer.local,nginx,localhost,api
BOUNDARY_LAYER_RATE_LIMIT_BACKEND=redis

# Data-plane TLS (enabled by default in docker-compose.prod.yml)
POSTGRES_SSLMODE=require
POSTGRES_SSL_ROOT_CERT=/app/tls/ca.crt
REDIS_TLS_ENABLED=true
REDIS_SSL_CA_CERT=/app/tls/ca.crt

# Optional alert webhook storage cap (default 1000)
# BOUNDARY_LAYER_ALERT_WEBHOOK_MAX_ALERTS=1000
# BOUNDARY_LAYER_CORS_ENABLED=true
# BOUNDARY_LAYER_CORS_ORIGINS=https://app.example.com
