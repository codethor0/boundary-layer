# BoundaryLayer staging environment (Production SaaS live validation)
# Copy to untracked .env.staging and fill with real values from your staging account.
# NEVER commit .env.staging. See docs/STAGING_SECRETS_INVENTORY.md.

# Live validation gate
RUN_LIVE_STAGING_CHECKS=true

# Runtime profile
BOUNDARY_LAYER_PROFILE=production-saas
BOUNDARY_LAYER_ENV=staging
BOUNDARY_LAYER_AUTH_ENABLED=true
BOUNDARY_LAYER_AUTH_PROVIDER=oidc

# Staging HTTP endpoints (public, non-secret URLs only)
STAGING_BASE_URL=https://staging.example.com
BOUNDARY_LAYER_PUBLIC_BASE_URL=https://staging.example.com
BOUNDARY_LAYER_ALLOWED_ORIGINS=https://staging.example.com

# OIDC (issuer/JWKS URLs are non-secret; client secret stays in IdP only)
OIDC_ISSUER_URL=https://staging-issuer.example.com
OIDC_AUDIENCE=boundary-layer-api-staging
OIDC_JWKS_URL=https://staging-issuer.example.com/.well-known/jwks.json
OIDC_TENANT_CLAIM=https://boundarylayer.dev/tenant_id
OIDC_ROLES_CLAIM=https://boundarylayer.dev/roles
OIDC_ALGORITHMS=RS256
OIDC_CLOCK_SKEW_SECONDS=60

# Test JWTs issued by your IdP for smoke tests (secrets — never commit)
STAGING_TEST_ACCESS_TOKEN_TENANT_A=
STAGING_TEST_ACCESS_TOKEN_TENANT_B=

# Managed PostgreSQL (secret — use sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@rds-endpoint.example:5432/boundary_layer?sslmode=require
DB_SSL_MODE=require
POSTGRES_PASSWORD=

# Managed Redis TLS (secret)
REDIS_URL=rediss://:AUTH_TOKEN@elasticache-endpoint.example:6379/0
REDIS_KEY_PREFIX=boundary_layer:tenant
REDIS_PASSWORD=

# Object storage (S3)
OBJECT_STORAGE_BUCKET=boundary-layer-staging-artifacts
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_PREFIX=tenants/
BOUNDARY_LAYER_FILE_STORAGE_BACKEND=s3

# Secret manager
SECRET_MANAGER_PROVIDER=aws
SECRET_MANAGER_PROJECT_OR_PATH=boundary-layer/staging
BOUNDARY_LAYER_HEALTHCHECK_SECRET_NAME=boundary-layer/healthcheck
SECRET_ROTATION_REQUIRED=true
SECRET_CACHE_TTL_SECONDS=300

# Application secrets (generate unique values per environment)
BOUNDARY_LAYER_SECRET_KEY=CHANGE_ME-staging-secret-key-min-32-chars
BOUNDARY_LAYER_API_KEY=
BOUNDARY_LAYER_METRICS_TOKEN=
STAGING_METRICS_AUTH_TOKEN=
BOUNDARY_LAYER_METRICS_AUTH_REQUIRED=true
SESSION_HMAC_SECRET=

# Audit
BOUNDARY_LAYER_AUDIT_LOG_ENABLED=true
AUDIT_SINK_PROVIDER=cloudwatch
AUDIT_IMMUTABLE_REQUIRED=false

# WAF / edge (configure after ALB + WAF provisioned)
WAF_ENABLED=true
AWS_WAF_WEB_ACL_ARN=
MAX_REQUEST_BODY_BYTES=1048576

# Container deploy (set after ECR push)
STAGING_RELEASE_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/boundary-layer-api:GIT_SHA
CONTAINER_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com/boundary-layer-api
PUSH_IMAGE=false

# AWS deploy context (non-secret identifiers)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECS_CLUSTER_NAME=boundary-layer-staging
ECS_SERVICE_NAME=boundary-layer-api

# Optional: enable real deploy (default false — dry run only)
DEPLOY_STAGING=false
